{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://js.stripe.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://lh3.googleusercontent.com https://lh4.googleusercontent.com https://lh5.googleusercontent.com https://lh6.googleusercontent.com; connect-src 'self' https://nepsaathi-production.up.railway.app wss://nepsaathi-production.up.railway.app https://accounts.google.com https://fcm.googleapis.com https://firebase.googleapis.com https://nominatim.openstreetmap.org https://www.google-analytics.com https://cloudflareinsights.com; frame-src https://accounts.google.com https://js.stripe.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "nepsaathi.com" }],
      "destination": "https://www.nepsaathi.com/$1",
      "permanent": true
    },
    { "source": "/announcements",       "destination": "/notices",              "permanent": true },
    { "source": "/announcements/:slug", "destination": "/notices/:slug",        "permanent": true },
    { "source": "/community",           "destination": "/forum",                "permanent": true },
    { "source": "/looking-for",         "destination": "/forum",                "permanent": true },
    { "source": "/guides",              "destination": "/guides/banking",       "permanent": true },
    { "source": "/banking",             "destination": "/guides/banking",       "permanent": true },
    { "source": "/health",              "destination": "/guides/health",        "permanent": true },
    { "source": "/tax",                 "destination": "/guides/tax",           "permanent": true },
    { "source": "/work-rights",         "destination": "/guides/work-rights",   "permanent": true },
    { "source": "/childcare",           "destination": "/guides/childcare",     "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/sitemap-forum.xml",
      "destination": "https://nepsaathi-production.up.railway.app/api/sitemap-forum.xml"
    },
    {
      "source": "/sitemap-listings.xml",
      "destination": "https://nepsaathi-production.up.railway.app/api/sitemap-listings.xml"
    },
    {
      "source": "/jobs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|SkypeUriPreview|Discordbot|Googlebot|AdsBot-Google|bingbot|Applebot|Pinterestbot|Snapchat).*"
        }
      ],
      "destination": "https://nepsaathi-production.up.railway.app/api/og/job/:slug/"
    },
    {
      "source": "/rooms/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|SkypeUriPreview|Discordbot|Googlebot|AdsBot-Google|bingbot|Applebot|Pinterestbot|Snapchat).*"
        }
      ],
      "destination": "https://nepsaathi-production.up.railway.app/api/og/room/:slug/"
    },
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|SkypeUriPreview|Discordbot|Googlebot|AdsBot-Google|bingbot|Applebot|Pinterestbot|Snapchat).*"
        }
      ],
      "destination": "https://nepsaathi-production.up.railway.app/api/og/event/:slug/"
    },
    {
      "source": "/notices/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|SkypeUriPreview|Discordbot|Googlebot|AdsBot-Google|bingbot|Applebot|Pinterestbot|Snapchat).*"
        }
      ],
      "destination": "https://nepsaathi-production.up.railway.app/api/og/notice/:slug/"
    },
    {
      "source": "/businesses/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|SkypeUriPreview|Discordbot|Googlebot|AdsBot-Google|bingbot|Applebot|Pinterestbot|Snapchat).*"
        }
      ],
      "destination": "https://nepsaathi-production.up.railway.app/api/og/business/:slug/"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
